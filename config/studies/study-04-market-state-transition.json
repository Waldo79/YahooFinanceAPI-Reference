{
  "study_id": "study-04-market-state-transition",
  "study_version": "0.1.0",
  "study_title": "Market-state transition interval study",
  "study_variable": "market_state_over_time",
  "session_mode": "cookie-crumb",
  "request_order": "round-major configured subject order",
  "sampling": {
    "duration_hours": 26,
    "interval_minutes": 15,
    "include_initial_round": true,
    "expected_round_count": 105,
    "expected_request_count": 1365,
    "notes": "A 26-hour rolling window spans one full daily cycle for the reviewed international panel when started on a normal weekday. Fifteen-minute cadence is a baseline; boundary refinement may use a shorter override."
  },
  "transition_controls": {
    "preserve_exact_market_state_strings": true,
    "observed_values_of_interest": [
      "PREPRE",
      "PRE",
      "REGULAR",
      "POST",
      "POSTPOST"
    ],
    "extended_hours_field_groups": {
      "pre_market": [
        "preMarketChange",
        "preMarketChangePercent",
        "preMarketPrice",
        "preMarketTime"
      ],
      "post_market": [
        "postMarketChange",
        "postMarketChangePercent",
        "postMarketPrice",
        "postMarketTime"
      ]
    }
  },
